# ==============================================================================
# GuideFlow AI - Environment Configuration Example
# ==============================================================================

# Google Gemini API Key for natural language understanding and visual analysis
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Default interface language (en = English, te = Telugu, hi = Hindi)
DEFAULT_LANGUAGE=en

# Default UI Theme (light or dark)
DEFAULT_THEME=light

# Voice audio playback speed (0.8 to 1.2) - 0.9 is ideal for seniors
SPEECH_SPEED=0.95
